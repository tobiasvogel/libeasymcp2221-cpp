prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@LIBEASYMCP2221_CPP_PKGCONFIG_LIBDIR@
includedir=@LIBEASYMCP2221_CPP_PKGCONFIG_INCLUDEDIR@

Name: libeasymcp2221++
Version: @PROJECT_VERSION@
Description: Object-oriented C++17 adapter for libeasymcp2221
Requires.private: libeasymcp2221 >= 2.0.1
Libs: -L${libdir} -leasymcp2221++
Cflags: -I${includedir}
