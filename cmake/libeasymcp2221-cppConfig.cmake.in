@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if (MSVC)
    find_path(
        LIBEASYMCP2221_INCLUDE_DIR
        NAMES libeasymcp2221/mcp2221.h
    )
    if (NOT LIBEASYMCP2221_INCLUDE_DIR)
        set(libeasymcp2221-cpp_FOUND FALSE)
        set(
            libeasymcp2221-cpp_NOT_FOUND_MESSAGE
            "libeasymcp2221 MSVC headers were not found. Add the "
            "libeasymcp2221 install prefix to CMAKE_PREFIX_PATH."
        )
        return()
    endif()

    if (@LIBEASYMCP2221_CPP_BUILD_SHARED@)
        find_library(
            LIBEASYMCP2221_SHARED_LIBRARY
            NAMES libeasymcp2221
        )
        if (NOT LIBEASYMCP2221_SHARED_LIBRARY)
            set(libeasymcp2221-cpp_FOUND FALSE)
            set(
                libeasymcp2221-cpp_NOT_FOUND_MESSAGE
                "The libeasymcp2221 MSVC shared import library was not "
                "found. Add its install prefix to CMAKE_PREFIX_PATH."
            )
            return()
        endif()

        if (NOT TARGET libeasymcp2221_cpp_c_shared)
            add_library(libeasymcp2221_cpp_c_shared UNKNOWN IMPORTED)
            set_target_properties(
                libeasymcp2221_cpp_c_shared
                PROPERTIES
                    IMPORTED_LOCATION "${LIBEASYMCP2221_SHARED_LIBRARY}"
                    INTERFACE_INCLUDE_DIRECTORIES "${LIBEASYMCP2221_INCLUDE_DIR}"
            )
        endif()
    endif()

    if (@LIBEASYMCP2221_CPP_BUILD_STATIC@)
        find_library(
            LIBEASYMCP2221_STATIC_LIBRARY
            NAMES libeasymcp2221_static
        )
        if (NOT LIBEASYMCP2221_STATIC_LIBRARY)
            set(libeasymcp2221-cpp_FOUND FALSE)
            set(
                libeasymcp2221-cpp_NOT_FOUND_MESSAGE
                "The libeasymcp2221 MSVC static library was not found. "
                "Add its install prefix to CMAKE_PREFIX_PATH."
            )
            return()
        endif()

        find_library(
            LIBEASYMCP2221_LIBUSB_LIBRARY
            NAMES libusb-1.0
        )
        if (NOT LIBEASYMCP2221_LIBUSB_LIBRARY)
            set(libeasymcp2221-cpp_FOUND FALSE)
            set(
                libeasymcp2221-cpp_NOT_FOUND_MESSAGE
                "libusb-1.0 was not found for the static libeasymcp2221 "
                "dependency."
            )
            return()
        endif()

        if (NOT TARGET libeasymcp2221_cpp_c_static)
            add_library(libeasymcp2221_cpp_c_static UNKNOWN IMPORTED)
            set_target_properties(
                libeasymcp2221_cpp_c_static
                PROPERTIES
                    IMPORTED_LOCATION "${LIBEASYMCP2221_STATIC_LIBRARY}"
                    INTERFACE_INCLUDE_DIRECTORIES "${LIBEASYMCP2221_INCLUDE_DIR}"
                    INTERFACE_COMPILE_DEFINITIONS LIBEASYMCP2221_STATIC
                    INTERFACE_LINK_LIBRARIES "${LIBEASYMCP2221_LIBUSB_LIBRARY}"
            )
        endif()
    endif()
else()
    find_dependency(PkgConfig)
    pkg_check_modules(
        LIBEASYMCP2221
        REQUIRED
        IMPORTED_TARGET
        "libeasymcp2221>=2.0.1"
    )
    if (@LIBEASYMCP2221_CPP_BUILD_STATIC@ AND
        NOT TARGET libeasymcp2221_cpp_c_static)
        set(
            _LIBEASYMCP2221_CPP_SAVED_LIBRARY_SUFFIXES
            "${CMAKE_FIND_LIBRARY_SUFFIXES}"
        )
        set(CMAKE_FIND_LIBRARY_SUFFIXES "${CMAKE_STATIC_LIBRARY_SUFFIX}")
        find_library(
            LIBEASYMCP2221_STATIC_LIBRARY
            NAMES easymcp2221
            HINTS
                ${LIBEASYMCP2221_STATIC_LIBRARY_DIRS}
                ${LIBEASYMCP2221_LIBDIR}
            NO_DEFAULT_PATH
        )
        set(
            CMAKE_FIND_LIBRARY_SUFFIXES
            "${_LIBEASYMCP2221_CPP_SAVED_LIBRARY_SUFFIXES}"
        )
        unset(_LIBEASYMCP2221_CPP_SAVED_LIBRARY_SUFFIXES)
        if (NOT LIBEASYMCP2221_STATIC_LIBRARY)
            set(libeasymcp2221-cpp_FOUND FALSE)
            set(
                libeasymcp2221-cpp_NOT_FOUND_MESSAGE
                "The static libeasymcp2221 library was not found in the "
                "pkg-config library directories."
            )
            return()
        endif()

        pkg_check_modules(
            LIBEASYMCP2221_LIBUSB
            REQUIRED
            IMPORTED_TARGET
            "libusb-1.0"
        )
        find_dependency(Threads)

        set(
            LIBEASYMCP2221_CPP_STATIC_C_DEPENDENCIES
            PkgConfig::LIBEASYMCP2221_LIBUSB
            Threads::Threads
        )

        list(FIND LIBEASYMCP2221_STATIC_LIBRARIES "m"
            LIBEASYMCP2221_CPP_STATIC_MATH_INDEX)
        if (NOT LIBEASYMCP2221_CPP_STATIC_MATH_INDEX EQUAL -1)
            find_library(LIBEASYMCP2221_MATH_LIBRARY m)
            if (NOT LIBEASYMCP2221_MATH_LIBRARY)
                set(libeasymcp2221-cpp_FOUND FALSE)
                set(
                    libeasymcp2221-cpp_NOT_FOUND_MESSAGE
                    "libeasymcp2221 requires libm for static linking, but "
                    "libm was not found."
                )
                return()
            endif()
            list(APPEND
                LIBEASYMCP2221_CPP_STATIC_C_DEPENDENCIES
                "${LIBEASYMCP2221_MATH_LIBRARY}"
            )
        endif()

        add_library(libeasymcp2221_cpp_c_static STATIC IMPORTED)
        set_target_properties(
            libeasymcp2221_cpp_c_static
            PROPERTIES
                IMPORTED_LOCATION "${LIBEASYMCP2221_STATIC_LIBRARY}"
                INTERFACE_INCLUDE_DIRECTORIES "${LIBEASYMCP2221_INCLUDE_DIRS}"
                INTERFACE_COMPILE_DEFINITIONS LIBEASYMCP2221_STATIC
                INTERFACE_LINK_LIBRARIES
                    "${LIBEASYMCP2221_CPP_STATIC_C_DEPENDENCIES}"
        )
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/libeasymcp2221-cppTargets.cmake")

set(libeasymcp2221-cpp_Qt_FOUND FALSE)

if ("Qt" IN_LIST libeasymcp2221-cpp_FIND_COMPONENTS)
    set(
        _LIBEASYMCP2221_CPP_QT_TARGETS_FILE
        "${CMAKE_CURRENT_LIST_DIR}/libeasymcp2221-cppQtTargets.cmake"
    )

    if (@LIBEASYMCP2221_CPP_HAS_QT@ AND
        EXISTS "${_LIBEASYMCP2221_CPP_QT_TARGETS_FILE}")
        find_dependency(Qt6 COMPONENTS Core)

        include("${_LIBEASYMCP2221_CPP_QT_TARGETS_FILE}")
        set(libeasymcp2221-cpp_Qt_FOUND TRUE)
    elseif (@LIBEASYMCP2221_CPP_HAS_QT@)
        set(
            libeasymcp2221-cpp_NOT_FOUND_MESSAGE
            "The Qt component was requested, but its CMake target export "
            "is not installed. Install the libeasymcp2221++ Qt development "
            "package (for Debian: libeasymcp2221++-qt-dev)."
        )
    else()
        set(
            libeasymcp2221-cpp_NOT_FOUND_MESSAGE
            "The installed libeasymcp2221++ package was built without "
            "the Qt component."
        )
    endif()

    unset(_LIBEASYMCP2221_CPP_QT_TARGETS_FILE)
endif()

check_required_components(libeasymcp2221-cpp)
